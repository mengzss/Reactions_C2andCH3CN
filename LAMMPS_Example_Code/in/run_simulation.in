
variable lv1 index 10 30 100 500   &
1000 1100  1200  1300  1400  1500  1600  1700  1800 1900  &
2000 2010  2020  2030  2040  2050  2060  2070  2080 2090  &
2100 2110  2120  2130  2140  2150  2160  2170  2180 2190  &
2200 2210  2220  2230  2240  2250  2260  2270  2280 2290  &
2300 2310  2320  2330  2340  2350  2360  2370  2380 2390  &
2400 2410  2420  2430  2440  2450  2460  2470  2480 2490  &
2500 2510  2520  2530  2540  2550  2560  2570  2580 2590  &
2600 2610  2620  2630  2640  2650  2660  2670  2680 2690  &
2700 2710  2720  2730  2740  2750  2760  2770  2780 2790  &
2800 2810  2820  2830  2840  2850  2860  2870  2880 2890  &
2900 2910  2920  2930  2940  2950  2960  2970  2980 2990  &
3000 3010  3020  3030  3040  3050  3060  3070  3080 3090  &
3100 3110  3120  3130  3140  3150  3160  3170  3180 3190  &
3200 3210  3220  3230  3240  3250  3260  3270  3280 3290  &
3300 3310  3320  3330  3340  3350  3360  3370  3380 3390  &
3400 3410  3420  3430  3440  3450  3460  3470  3480 3490  &
3500 3510  3520  3530  3540  3550  3560  3570  3580 3590  &
3600 3610  3620  3630  3640  3650  3660  3670  3680 3690  &
3700 3710  3720  3730  3740  3750  3760  3770  3780 3790  &
3800 3810  3820  3830  3840  3850  3860  3870  3880 3890  &
3900 3910  3920  3930  3940  3950  3960  3970  3980 3990  &
4000 4010  4020  4030  4040  4050  4060  4070  4080 4090  &
4100 4110  4120  4130  4140  4150  4160  4170  4180 4190  &
4200 4210  4220  4230  4240  4250  4260  4270  4280 4290  &
4300 4310  4320  4330  4340  4350  4360  4370  4380 4390  &
4400 4410  4420  4430  4440  4450  4460  4470  4480 4490  4500 

label Loop
variable lv2 index 10 

variable  infilename index  run_simulation
variable  datafilename index  CH3CN_C2

variable Fid  string CH3CN_C2-${lv1}K
variable logfile string ${Fid}-log
log ../log/${logfile}.txt


variable        dt equal 0.1  #fs
variable        runStep equal 1000000     
variable        Thi  equal ${lv1}
variable        Tlo equal ${lv2}    

units           real  #metal  real
dimension       3
boundary        ff  ff  ff #  p p p  ff  ff  ff
atom_style      full
read_data       ../Datafile/${datafilename}.data   

group 1 type 1
group 2 type 2  
group CH3CN molecule  1  
group C2 molecule  2
group mv union CH3CN C2 
group mole union CH3CN C2

###Pair

pair_style reaxff  NULL safezone 2.6 mincap 1000
pair_coeff * *  ../potential_file/CHON.ff C H   O   N
fix p1 all qeq/reax 1 0.0 10.0 1.0e-5 reaxff

neigh_modify delay 0 every 1 check yes page 500000 one 50000
timestep     ${dt}
run 0

###=========================================

fix wall all wall/reflect xlo EDGE xhi EDGE  ylo EDGE yhi EDGE  zlo EDGE zhi EDGE

thermo       1000
thermo_style custom step temp pe etotal ke epair ebond eangle  edihed  eimp  vol

thermo_modify lost ignore

dump        1  all xyz 1000 ../XYZ/${Fid}.xyz
dump_modify 1  element C  H   O   N
dump_modify 1  first yes

dump        2  mole xyz 1000 ../XYZ2/${Fid}.xyz
dump_modify 2  element C  H   O  N
dump_modify 2  first yes

variable    Time  equal step*${dt}
variable    Tav equal temp
variable    PE equal pe
variable    Eke equal ke
variable    Eepair equal  epair
variable    Etot  equal  etotal
fix         E1 all  ave/time 2 500 1000 v_Tav  v_PE  v_Eke v_Eepair   v_Etot ave running &
  file ../OUT/${Fid}.data mode scalar 

##=====================================
run 0
velocity CH3CN create ${Tlo} 102486 mom yes rot yes dist gaussian
velocity C2 create ${Tlo} 102486 mom yes rot yes dist gaussian

fix 5 all nvt temp ${Tlo} ${Thi} $(100*dt) # 0.05  50

run ${runStep}
run ${runStep}
run ${runStep}
run ${runStep}
run ${runStep}

unfix 5
fix 5 all nvt temp ${Thi} ${Thi} $(100*dt) # 0.05  50

run ${runStep}
run ${runStep}
run ${runStep}
run ${runStep}
run ${runStep}
run ${runStep}
run ${runStep}
run ${runStep}
run ${runStep}
run ${runStep}

unfix 5
fix 5 all nvt temp ${Thi} ${Tlo} $(100*dt) # 0.05  50

run ${runStep}
run ${runStep}
run ${runStep}
run ${runStep}
run ${runStep}

unfix 5
##==============================================
clear
next lv2
jump ${infilename}.in Loop

